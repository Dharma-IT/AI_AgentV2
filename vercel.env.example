# Add these in Vercel: Project Settings > Environment Variables.
# They are required by the frontend for Supabase administrator authentication.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Backend API requests stay same-origin in the browser and are proxied to:
# https://ai-agent-v2-tea5.onrender.com/api/*
# Do not add OpenAI, HubSpot, Respond.io, Aircall, or Supabase service-role
# secrets to Vercel. Those values belong only in Render.
