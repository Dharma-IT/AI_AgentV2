# Server-only secrets. Never prefix the API key with VITE_.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_DEBUG=false
PORT=3001

# Optional during Milestone 3.1. Keep all three server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Browser-safe Supabase Auth configuration. Never use the service-role key here.
# Add these two values to Vercel for Preview and Production deployments.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only production integrations. Never prefix these with VITE_.
RESPOND_API_TOKEN=
HUBSPOT_PRIVATE_APP_TOKEN=
AIRCALL_API_ID=
AIRCALL_API_TOKEN=
